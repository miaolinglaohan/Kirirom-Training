/* pages/profile/index.wxss */
page {
  background: #f5f5f7;
  min-height: 100vh;
}

.profile {
  padding-bottom: 40rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #1bcfad 0%, #14b39a 100%);
  padding: 60rpx 40rpx 60rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.avatar-text {
  font-size: 56rpx;
  font-weight: 600;
  color: #1bcfad;
}

.user-info {
  margin-left: 32rpx;
  flex: 1;
}

.user-name {
  font-size: 38rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.user-meta {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.user-meta .hint {
  color: rgba(255, 255, 255, 0.75);
}

/* 通用 section */
.section {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.openid-box {
  background: #f0f0f0;
  border-radius: 8rpx;
  padding: 20rpx;
  word-break: break-all;
}

.openid-text {
  font-size: 26rpx;
  color: #333;
  font-family: Consolas, monospace;
}

.copy-btn {
  margin-top: 24rpx;
  background: #1bcfad;
  color: #fff;
  text-align: center;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 8rpx;
}

.copy-btn:active {
  background: #14b39a;
}

/* 菜单列表 */
.menu-list {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-item:active {
  background: #f8f8f8;
}

.menu-label {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.admin-item .menu-label {
  color: #1bcfad;
  font-weight: 500;
}

/* 底部 */
.footer {
  text-align: center;
  font-size: 24rpx;
  color: #aaa;
  margin-top: 60rpx;
}
