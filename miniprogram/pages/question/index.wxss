.page-question{
    width: 100%;
    background-color: #f0f0f0;
    margin-bottom: 50px;
}
.page-question .questions{
    padding-top: 10px;
    padding-bottom: 20px;
    background-color: #fff;
}
.page-question .question-container .question{
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    background-color: #f0f0f0;
    padding-top:5px;
    padding-bottom:5px;
    min-height: 50px;
}
.page-question .question-container .question .sortcode{
    padding-left: 10px;

}
.page-question .question-container .question .title{
    padding-left: 10px;
}
.page-question .question-container .options{
    padding-bottom:5px;
}
.page-question .question-container .options .radio-group {
    border-bottom: 1px solid #ddd;
    padding-top:5px;
    padding-bottom:5px;
}
.page-question .question-container .options .radio {
    display: block;
    border-top: 1px solid #ddd;
    padding: 10px;
}
.page-question .btn-area{
    padding: 10px;
    margin-bottom: 100px;
}

/* 题型筛选 tab */
.type-tabs {
    display: flex;
    background: #fff;
    padding: 4px;
    position: sticky;
    top: 0;
    z-index: 10;
}
.type-tabs .tab {
    flex: 1;
    text-align: center;
    font-size: 26rpx;
    padding: 10rpx 0;
    color: #666;
    border-radius: 8rpx;
}
.type-tabs .tab.active {
    background: #07c160;
    color: #fff;
    font-weight: 600;
}

/* 空态 */
.empty {
    text-align: center;
    padding: 80rpx 0;
    color: #999;
    font-size: 28rpx;
}

/* 回顾栏 */
.review-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff;
    padding: 16rpx 24rpx;
    box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06);
    z-index: 100;
}
.review-stats {
    display: flex;
    align-items: center;
    gap: 16rpx;
    font-size: 28rpx;
}
.review-stats .stat-right { color: #07c160; font-weight: 600; }
.review-stats .stat-wrong { color: #e64340; font-weight: 600; }
.review-stats .stat-total { color: #999; }
.review-btn {
    background: #07c160;
    color: #fff;
    font-size: 26rpx;
    padding: 10rpx 32rpx;
    border-radius: 100rpx;
}

/* 题号网格 */
.review-grid {
    position: fixed;
    bottom: 100rpx;
    left: 0;
    right: 0;
    background: #fff;
    padding: 20rpx 24rpx;
    box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.1);
    z-index: 99;
    max-height: 400rpx;
    overflow-y: auto;
}
.review-grid .grid-title {
    font-size: 24rpx;
    color: #888;
    margin-bottom: 12rpx;
}
.review-grid .grid-cells {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}
.review-grid .cell {
    width: 64rpx;
    height: 64rpx;
    line-height: 64rpx;
    text-align: center;
    border-radius: 8rpx;
    font-size: 26rpx;
    font-weight: 600;
}
.review-grid .cell-right {
    background: #e8f8ee;
    color: #07c160;
    border: 1rpx solid #a8e6c0;
}
.review-grid .cell-wrong {
    background: #fff0ed;
    color: #e64340;
    border: 1rpx solid #f5c6c0;
}
.review-grid .cell-skip {
    background: #f5f5f5;
    color: #bbb;
    border: 1rpx solid #e8e8e8;
}