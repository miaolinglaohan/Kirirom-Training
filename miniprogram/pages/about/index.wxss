.page-about{
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
}
.page-about .title{
    height: 50px;
    line-height: 50px;
    vertical-align: middle;
    background-color: #fff;
    padding-left: 10px;
}
.page-about .desc{
    height: 120px;
    background-color: #fff;
    border-top: 1px solid #f0f0f0;
    padding-top: 10px;
    padding-left: 10px;
    width: 97%;
}
.page-about .wechat{
    font-weight: 700;
    color: rgb(0, 0, 0);
    display: inline;
    padding-top: 10px;
    padding-left: 10px;
}
