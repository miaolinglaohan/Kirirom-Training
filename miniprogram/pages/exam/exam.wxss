page {
  background-color: #f5f7fa;
  height: 100%;
}

.exam-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* ── 加载占位 ── */
.loading {
  padding: 80rpx 30rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* ── 顶部状态栏 ── */
.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.topbar-left {
  font-size: 30rpx;
  color: #333;
  display: flex;
  align-items: center;
}
.topbar-left .qpos {
  font-size: 40rpx;
  font-weight: 600;
  color: #1bcfad;
}
.topbar-left .qsep {
  margin: 0 4rpx;
  color: #ccc;
}
.topbar-left .qtotal {
  color: #999;
}
.topbar-tag {
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  background-color: #e8f9f5;
  color: #1bcfad;
  font-size: 22rpx;
  border-radius: 16rpx;
}
.topbar-tag-score {
  background-color: #fff4dc;
  color: #d48b1a;
}
.topbar-right {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-family: Menlo, Consolas, monospace;
}
.clock-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}
.remain {
  color: #333;
  font-weight: 600;
}
.remain-low {
  color: #e74c3c;
  animation: blink 1s infinite;
}
@keyframes blink {
  50% { opacity: 0.4; }
}

/* ── 进度条 ── */
.progress-bar {
  height: 6rpx;
  background-color: #ecf0f3;
  position: sticky;
  top: 96rpx;
  z-index: 9;
}
.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #1bcfad 0%, #1dcc70 100%);
  transition: width 0.3s;
}

/* ── 题目卡片 ── */
.question-card {
  margin: 24rpx 24rpx 32rpx;
  padding: 32rpx 28rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.qtitle {
  font-size: 32rpx;
  line-height: 1.6;
  color: #222;
  margin-bottom: 24rpx;
}
.qtype {
  display: inline-block;
  margin-right: 12rpx;
  padding: 4rpx 14rpx;
  background-color: #1bcfad;
  color: #fff;
  font-size: 22rpx;
  border-radius: 8rpx;
  vertical-align: middle;
}
.qcontent {
  vertical-align: middle;
}

/* ── 选项 ── */
.options {
  display: flex;
  flex-direction: column;
}
.option {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  background-color: #f7f9fb;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  transition: all 0.15s;
}
.option-selected {
  background-color: #e8f9f5;
  border-color: #1bcfad;
}
.opt-icon {
  width: 44rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.opt-mark {
  font-size: 36rpx;
  color: #b9bfc6;
  line-height: 1;
}
.option-selected .opt-mark {
  color: #1bcfad;
}
.opt-body {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}
.opt-code {
  font-weight: 600;
  margin-right: 8rpx;
}

/* ── 判断题：大按钮 UI ── */
.judge-options {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 12rpx;
}
.judge-btn {
  flex: 1;
  margin: 0 12rpx;
  padding: 48rpx 20rpx;
  background-color: #f7f9fb;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}
.judge-btn:first-child { margin-left: 0; }
.judge-btn:last-child  { margin-right: 0; }
.judge-btn-selected {
  background-color: #e8f9f5;
  border-color: #1bcfad;
}
.judge-mark {
  font-size: 56rpx;
  color: #b9bfc6;
  line-height: 1;
  margin-bottom: 12rpx;
}
.judge-btn-selected .judge-mark {
  color: #1bcfad;
}
.judge-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}
.judge-btn-selected .judge-text {
  color: #1bcfad;
}

/* ── 底部操作栏 ── */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx env(safe-area-inset-bottom);
  background-color: #fff;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
  z-index: 10;
}
.nav-btn {
  flex: 1;
  margin: 0 8rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f4f5f7;
}
.nav-btn-disabled {
  opacity: 0.4;
}
.nav-btn-jump {
  background-color: #fff;
  border: 2rpx solid #1bcfad;
  color: #1bcfad;
}
.nav-btn-submit {
  background-color: #1bcfad;
  color: #fff;
  font-weight: 600;
}

/* ── 保存状态 ── */
.saved-status {
  position: fixed;
  right: 24rpx;
  bottom: 130rpx;
  font-size: 22rpx;
  color: #999;
  padding: 6rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
}

/* ── 跳题面板 ── */
.jump-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 50;
}
.jump-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  z-index: 51;
  max-height: 70vh;
  overflow-y: auto;
}
.jump-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.jump-close {
  font-size: 48rpx;
  color: #999;
  font-weight: 400;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
}
.jump-legend {
  display: flex;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 20rpx;
}
.legend-item {
  margin-right: 24rpx;
  display: flex;
  align-items: center;
}
.legend-dot {
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}
.legend-done { background-color: #1bcfad; }
.legend-todo { background-color: #ecf0f3; }
.legend-cur  { background-color: #f39c12; }

.jump-grid {
  display: flex;
  flex-wrap: wrap;
}
.jump-cell {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  margin: 8rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.jump-cell-todo { background-color: #ecf0f3; color: #666; }
.jump-cell-done { background-color: #1bcfad; color: #fff; }
.jump-cell-cur  { background-color: #f39c12; color: #fff; font-weight: 600; }

.jump-submit {
  margin-top: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #1bcfad;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}

/* ── 交卷蒙层 ── */
.submit-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}
.submit-mask-text {
  background-color: #fff;
  color: #333;
  padding: 30rpx 50rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}
