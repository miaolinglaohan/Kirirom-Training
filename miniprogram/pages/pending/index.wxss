/* pages/pending/index.wxss */
page {
  background: #f5f6fa;
  min-height: 100vh;
}

.page-pending {
  padding: 48rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}

.icon {
  font-size: 72rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 28rpx;
  color: #888;
  text-align: center;
  line-height: 1.6;
}

.label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.openid-box {
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.openid-text {
  font-size: 26rpx;
  color: #333;
  font-family: Consolas, monospace;
  word-break: break-all;
  user-select: text;
}

.copy-btn {
  text-align: center;
  font-size: 28rpx;
  color: #07c160;
  padding: 16rpx;
  background: #e8f8ee;
  border-radius: 10rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 26rpx;
  color: #555;
  line-height: 2;
}

.btn-area {
  width: 100%;
  margin-top: 8rpx;
}

.refresh-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.footer-tip {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
}
