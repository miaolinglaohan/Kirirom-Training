page{
    background-color: #f8fafc;
}
.page-simple{
    width: 100%;
}
.page-simple .sortnumber{
    padding: 5px;
    display: flex;
    flex-wrap: nowrap;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    height: 35px;
}
.page-simple .sortnumber .current{
    width: 20px;
    height: 20px;
    border-radius: 10px;
    color: #fff;
    background-color: #07c160;
        /* 新增下面两行实现居中 */
        display: flex;
        align-items: center;
        justify-content: center;
        /* 修改这里调整文字尺寸，按需改数值，比如10px、9px */
        font-size: 14px;
}
.page-simple .sortnumber .total{
    width: 20px;
    height: 20px;
    border-radius: 10px;
    color: #fff;
    background-color: #07c160;
        /* 居中配置和上面保持一致 */
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
}
.page-simple .sortnumber .fav-btn {
    margin-left: 8px;
    font-size: 22px;
    color: #ccc;
    line-height: 1;
}
.page-simple .sortnumber .fav-on {
    color: #f5a623;
}
.page-simple .question{
    
}
.page-simple .question .title{
    background-color: #fff;
    width: 95%;
    padding: 10px;
    min-height: 65px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
}
.page-simple .question .title text{
    height: 100%;
}
.page-simple .question .type{
    background-color: #fff;
    margin: 5px 0;
    height: 45px;
    line-height: 45px;
    vertical-align: middle;
    padding-left: 10px;
}
.page-simple .question .options{
    background-color: #fff;
}
.page-simple .question .option{
    padding: 5px;
}
.page-simple .radio-group {
    border-bottom: 1px solid #f8fafc;
    padding: 5px 0;
}
.page-simple .radio {
    display: block;
    border-top: 1px solid #f8fafc;
    padding: 10px;
}
.page-simple .radio .option-content{

}
.page-simple .radio .option-content radio{
    display: inline;
}
.page-simple .radio .option-content .content{
    display: inline;
}

/* 答题反馈 */
.page-simple .radio.opt-correct {
    background: #e8f8ee;
}
.page-simple .radio.opt-wrong {
    background: #fff0ed;
}
.page-simple .radio.opt-miss {
    background: #eaf4ff;
}
.mark {
    margin-left: 8px;
    font-size: 18px;
    font-weight: bold;
}
.mark-ok { color: #07c160; }
.mark-err { color: #e64340; }
.mark-miss { color: #1890ff; }

/* 正确答案文字 */
.page-simple .correct-answer {
    background: #fff;
    padding: 12rpx 20rpx;
    color: #07c160;
    font-size: 28rpx;
    font-weight: 600;
}
.page-simple .btn-area{
    margin-top: 10px;
    padding: 10px 0;
    margin-bottom: 120rpx;  /* 为常驻统计栏留出空间 */
    width: 100%;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
}
.page-simple .btn-area .btn{
    background-color: #07c160;
    width: 375rpx;
    border-radius: 35px;
    padding: 5px 10px;
    text-align: center;
    color: #fff;

}
.page-simple .btn-area .btn-prev{
    background-color: #fff;
    color: #07c160;
    border: 1px solid #07c160;
    margin-right: 20rpx;
}
.page-simple .btn-area .btn-disabled{
    background-color: #f5f5f5 !important;
    color: #bbb !important;
    border-color: #e8e8e8 !important;
}
.page-simple .btn-area .btn-finished{
    background-color: #ccc;
}

/* 题型筛选 tab */
.type-tabs {
    display: flex;
    background: #fff;
    padding: 4px;
    margin: 0 0 8px;
}
.type-tabs .tab {
    flex: 1;
    text-align: center;
    font-size: 26rpx;
    padding: 10rpx 0;
    color: #666;
    border-radius: 8rpx;
}
.type-tabs .tab.active {
    background: #07c160;
    color: #fff;
    font-weight: 600;
}

/* 空态 */
.empty {
    text-align: center;
    padding: 80rpx 0;
    color: #999;
    font-size: 28rpx;
}

/* 回顾栏 */
.review-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff;
    padding: 16rpx 24rpx;
    box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06);
    z-index: 100;
}
.review-stats {
    display: flex;
    align-items: center;
    gap: 16rpx;
    font-size: 28rpx;
}
.review-stats .stat-right { color: #07c160; font-weight: 600; }
.review-stats .stat-wrong { color: #e64340; font-weight: 600; }
.review-stats .stat-answered { color: #333; font-weight: 600; }
.review-stats .stat-total { color: #999; }
.review-btn {
    background: #07c160;
    color: #fff;
    font-size: 26rpx;
    padding: 10rpx 32rpx;
    border-radius: 100rpx;
}

/* 题号网格 */
.review-grid {
    position: fixed;
    bottom: 100rpx;
    left: 0;
    right: 0;
    background: #fff;
    padding: 20rpx 24rpx;
    box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.1);
    z-index: 99;
    max-height: 400rpx;
    overflow-y: auto;
}
.review-grid .grid-title {
    font-size: 24rpx;
    color: #888;
    margin-bottom: 12rpx;
}
.review-grid .grid-cells {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}
.review-grid .cell {
    width: 64rpx;
    height: 64rpx;
    line-height: 64rpx;
    text-align: center;
    border-radius: 8rpx;
    font-size: 26rpx;
    font-weight: 600;
}
.review-grid .cell-right {
    background: #e8f8ee;
    color: #07c160;
    border: 1rpx solid #a8e6c0;
}
.review-grid .cell-wrong {
    background: #fff0ed;
    color: #e64340;
    border: 1rpx solid #f5c6c0;
}
.review-grid .cell-skip {
    background: #f5f5f5;
    color: #bbb;
    border: 1rpx solid #e8e8e8;
}


radio .wx-radio-input{
    border-radius:50%;
    width:18px;
    height:18px;
}