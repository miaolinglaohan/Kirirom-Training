<wxs src="./../tools.wxs" module="JSON" />
<view class="page-simple">
    <!-- 题型筛选 tab -->
    <view class="type-tabs" wx:if="{{total > 0 || allQuestions.length > 0}}">
      <view
        class="tab {{activeTab === item.key ? 'active' : ''}}"
        wx:for="{{tabs}}" wx:key="key"
        data-key="{{item.key}}" bindtap="onTabChange">
        {{item.label}}
      </view>
    </view>

    <!-- 空题库提示 -->
    <view class="empty" wx:if="{{total === 0 && allQuestions.length === 0}}">
      <text>该题库下暂无题目</text>
    </view>

    <block wx:if="{{total > 0}}">
    <view class="sortnumber">
    <text class="current">{{idx + 1 > total ? total : idx + 1}}</text>/<text class="total">{{total}}</text>
    <view class="fav-btn {{favorited ? 'fav-on' : ''}}" bindtap="onToggleFavorite">
      {{favorited ? '★' : '☆'}}
    </view>
    </view>
    <view class="question" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
        <view class="title"><text>{{idx + 1 > total ? total : idx + 1}}、{{question.title}}</text></view>
        <view class="type">{{question.typename}}</view>
        <view class="options">
            <!-- 单选 / 判断 -->
            <radio-group wx:if="{{question.typecode !== '02'}}" class="radio-group" bindchange="radioChange">
            <label class="radio {{item.mark === 'ok' ? 'opt-correct' : ''}} {{item.mark === 'err' ? 'opt-wrong' : ''}}" wx:for="{{options}}" wx:key="code">
                <view class="option-content">
                    <radio value="{{item.code}}" checked="{{item.checked}}" disabled="{{answerState || finished}}"></radio>
                    <text class="content">{{item.code}}，{{item.content}}</text>
                    <text wx:if="{{item.mark === 'ok'}}" class="mark mark-ok">✓</text>
                    <text wx:if="{{item.mark === 'err'}}" class="mark mark-err">✗</text>
                </view>
            </label>
            </radio-group>
            <!-- 多选 -->
            <checkbox-group wx:if="{{question.typecode === '02'}}" class="radio-group" bindchange="checkboxChange">
            <label class="radio {{item.mark === 'ok' ? 'opt-correct' : ''}} {{item.mark === 'err' ? 'opt-wrong' : ''}} {{item.mark === 'miss' ? 'opt-miss' : ''}}" wx:for="{{options}}" wx:key="code">
                <view class="option-content">
                    <checkbox value="{{item.code}}" checked="{{item.checked}}" disabled="{{answerState || finished}}"></checkbox>
                    <text class="content">{{item.code}}，{{item.content}}</text>
                    <text wx:if="{{item.mark === 'ok'}}" class="mark mark-ok">✓</text>
                    <text wx:if="{{item.mark === 'miss'}}" class="mark mark-miss">✓</text>
                    <text wx:if="{{item.mark === 'err'}}" class="mark mark-err">✗</text>
                </view>
            </label>
            </checkbox-group>
        </view>
        <!-- 正确答案文字 -->
        <view class="correct-answer" wx:if="{{answerState}}">正确答案：{{correctText}}</view>
    </view>
    <view class="btn-area">
        <view class="btn btn-prev {{idx <= 0 ? 'btn-disabled' : ''}}" bindtap="onPrevTap">上一题</view>
        <view class="btn {{(finished && idx >= total - 1) ? 'btn-finished' : ''}}" bindtap="onNextTap">
            {{buttontext}}
        </view>
    </view>
    </block>

    <!-- 统计栏（常驻显示，实时更新） -->
    <view class="review-bar" wx:if="{{total > 0}}">
      <view class="review-stats">
        <text class="stat-answered">已答 {{answeredNum}}/{{total}}</text>
        <text class="stat-right">✔ {{rightNum}}</text>
        <text class="stat-wrong">❌ {{errNum}}</text>
      </view>
      <view class="review-btn" bindtap="onToggleReview">
        {{showReview ? '收起' : '回顾'}}
      </view>
    </view>

    <!-- 题号网格（点"回顾"展开） -->
    <view class="review-grid" wx:if="{{showReview}}">
      <view class="grid-title">点击题号回顾</view>
      <view class="grid-cells">
        <view
          class="cell {{score_arr[index] === 1 ? 'cell-right' : (code_arr[index] === 'M' ? 'cell-skip' : 'cell-wrong')}}"
          wx:for="{{arr}}" wx:key="*this" wx:for-index="index"
          data-idx="{{index}}" bindtap="onReviewJump">
          {{index + 1}}
        </view>
      </view>
    </view>
</view>
