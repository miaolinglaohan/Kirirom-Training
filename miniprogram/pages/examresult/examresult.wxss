/* pages/examresult/examresult.wxss */

page {
  background-color: #f5f7fa;
}
.result-page {
  padding-bottom: 200rpx;
}

/* —— 顶部分数 —— */
.topBG {
  background: linear-gradient(135deg, #1bd0ad 0%, #07c160 100%);
  padding: 60rpx 30rpx 50rpx;
  text-align: center;
  color: #fff;
}
.topBG .top .title {
  font-size: 32rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
}
.score-area {
  margin-top: 16rpx;
}
.score-num {
  font-size: 120rpx;
  font-weight: 700;
  line-height: 1;
}
.score-unit {
  font-size: 36rpx;
  margin-left: 10rpx;
  opacity: 0.85;
}
.accuracy {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.divider {
  height: 20rpx;
  background-color: #f5f7fa;
}

/* —— 概览统计 —— */
.summary-row {
  display: flex;
  background-color: #fff;
  padding: 30rpx 0;
  margin: 0 24rpx;
  margin-top: -20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 2;
}
.summary-cell {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #ecf0f3;
}
.summary-cell:last-child {
  border-right: none;
}
.cell-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
}
.cell-num.cell-right { color: #07c160; }
.cell-num.cell-wrong { color: #e74c3c; }
.cell-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* —— 展开/收起按钮 —— */
.review-toggle {
  margin: 30rpx 24rpx 0;
  padding: 28rpx;
  background-color: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.toggle-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.toggle-text {
  flex: 1;
  font-size: 30rpx;
  color: #07c160;
  font-weight: 600;
}
.toggle-arrow {
  font-size: 24rpx;
  color: #999;
}

/* —— 题目复盘 —— */
.review-list {
  margin: 20rpx 24rpx 0;
}
.review-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #07c160;
}
.review-card.review-wrong {
  border-left-color: #e74c3c;
}
.rev-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.rev-idx {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}
.rev-type {
  display: inline-block;
  padding: 4rpx 12rpx;
  background-color: #ecf0f3;
  color: #666;
  font-size: 22rpx;
  border-radius: 6rpx;
  margin-right: auto;
}
.rev-flag {
  font-size: 26rpx;
  font-weight: 600;
}
.flag-right { color: #07c160; }
.flag-wrong { color: #e74c3c; }

.rev-title {
  font-size: 30rpx;
  color: #222;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.rev-options {
  margin-bottom: 16rpx;
}
.rev-opt {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 16rpx;
  background-color: #f7f9fb;
  border-radius: 10rpx;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #555;
}
.rev-opt.opt-official {
  background-color: #e8f9f5;
  color: #0f8a73;
  font-weight: 500;
}
.rev-opt.opt-user-wrong {
  background-color: #fbe9e7;
  color: #c0392b;
  text-decoration: line-through;
}
.rev-opt-code {
  font-weight: 600;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.rev-opt-content {
  flex: 1;
}
.rev-opt-tag {
  margin-left: 12rpx;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
  align-self: center;
}
.tag-official {
  background-color: #07c160;
  color: #fff;
}
.tag-user {
  background-color: #e74c3c;
  color: #fff;
}

.rev-foot {
  font-size: 26rpx;
  color: #666;
  padding-top: 10rpx;
  border-top: 1rpx dashed #ecf0f3;
}
.ans-user.ans-right { color: #07c160; font-weight: 600; }
.ans-user.ans-wrong { color: #e74c3c; font-weight: 600; }
.ans-official { color: #07c160; font-weight: 600; }
.ans-sep { color: #ccc; margin: 0 12rpx; }

/* —— 正式考提示卡 —— */
.hint-card {
  margin: 30rpx 24rpx 0;
  padding: 28rpx;
  background-color: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border-left: 8rpx solid #07c160;
}
.hint-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.hint-body { flex: 1; }
.hint-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}
.hint-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* —— 错题入口（正式考） —— */
.action-card {
  margin: 30rpx 24rpx 0;
  padding: 28rpx;
  background-color: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.action-left {
  display: flex;
  align-items: center;
}
.action-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}
.action-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}
.action-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.num-wrong { color: #e74c3c; }
.action-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* —— 底部按钮 —— */
.bottom-actions {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background-color: #fff;
  display: flex;
  padding: 20rpx 24rpx env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.btn-primary, .btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin: 0 12rpx;
}
.btn-primary {
  background-color: #07c160;
  color: #fff;
  font-weight: 600;
}
.btn-secondary {
  background-color: #f4f5f7;
  color: #666;
}
