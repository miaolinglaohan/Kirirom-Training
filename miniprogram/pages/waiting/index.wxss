/* pages/waiting/index.wxss */
page {
  background: #f5f5f7;
  min-height: 100vh;
}

.waiting-page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 加载 / 空态 */
.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.back-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 100rpx;
}

/* 主卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.exam-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.exam-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.exam-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

/* 倒计时区 */
.countdown-area {
  background: linear-gradient(135deg, #f8feff 0%, #e6f7ff 100%);
  border-radius: 12rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  margin-bottom: 32rpx;
  transition: background 0.3s;
}

.countdown-area.countdown-done {
  background: linear-gradient(135deg, #f6ffed 0%, #d9f7d0 100%);
}

.countdown-label {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.countdown-value {
  font-size: 64rpx;
  color: #07c160;
  font-weight: 600;
  font-family: Consolas, monospace;
  letter-spacing: 2rpx;
}

/* 信息列表 */
.info-list {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-label {
  color: #888;
  width: 220rpx;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: #333;
  word-break: break-all;
}

/* 进入考场按钮 */
.enter-btn {
  margin-top: 40rpx;
  text-align: center;
  padding: 28rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  background: #f5f5f5;
  color: #999;
  transition: all 0.3s;
}

.enter-btn-active {
  background: #07c160;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}
