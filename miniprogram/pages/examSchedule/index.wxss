/* pages/examSchedule/index.wxss */
page {
  background: #f5f5f7;
  min-height: 100vh;
}

.schedule-page {
  padding-bottom: 40rpx;
}

.hint-bar {
  background: #fffbe6;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #fff4c6;
}

.hint-text {
  font-size: 24rpx;
  color: #8a6d3b;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空态 */
.empty {
  text-align: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.6;
}

/* 卡片 */
.list {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  flex: 1;
  margin-right: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
}

.tag-pending { background: #fff7e6; color: #d48806; }
.tag-ongoing { background: #f6ffed; color: #389e0d; }
.tag-expired { background: #f5f5f5; color: #999; }

.card-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.row-label {
  color: #888;
  width: 140rpx;
}

.row-value {
  flex: 1;
  color: #333;
  word-break: break-all;
}

.countdown-area {
  margin-top: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8feff 0%, #e6f7ff 100%);
  border-radius: 12rpx;
  text-align: center;
}

.countdown-label {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.countdown-value {
  font-size: 44rpx;
  color: #07c160;
  font-weight: 600;
  font-family: Consolas, monospace;
}

.action-bar {
  margin-top: 24rpx;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.action-pending {
  background: #f5f5f5;
  color: #999;
}

.action-ongoing {
  background: #07c160;
  color: #fff;
  font-weight: 600;
}

.action-expired {
  background: #fafafa;
  color: #bbb;
}
