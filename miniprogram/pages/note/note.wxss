page{
  background-color: #f8f9fb;
}
.note .sortnumber{
  padding: 10px;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: space-between;
  align-items: center;
}
.note .sortnumber .left{
  color: #b9bfc6;
}
.note .sortnumber  .right{
  /* 原浅绿色圆角容器样式，注释屏蔽 */
  /* background-color: #d8f3e7;
  border-radius: 10px; */
  /* 新增：数字与斜杠增加间距，排版更美观 */
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.note .sortnumber .right text{
  /* 原绿色圆形数字样式，全部注释屏蔽 */
  /* width: 20px;
  height: 20px;
  border-radius: 10px;
  color: #fff;
  background-color: #07c160; */
  display: inline-block;
  /* 新增：文字改为深色，无背景时正常显示 */
  color: #333;
}
.note .progress{
  padding: 10px;
}
.note .question{
  background-color: #f8f9fb;
}
.note .question .title{
  background-color: #fff;
  padding: 10px;
  margin-bottom: 5px;
}
.note .question .type{
  background-color: #fff;
  margin: 5px 0;
  height: 45px;
  line-height: 45px;
  vertical-align: middle;
  padding-left: 10px;
}
.note .question .options{
  background-color: #fff;
  padding: 10px;
  margin-bottom: 5px;
}
.note .question .options .option{
  padding: 10px;
  border-bottom: 1rpx solid #f8f9fb;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: flex-start;
  align-items: flex-start;
}
.note .question .options .option .icon image{
  width: 20px;
  height: 20px;
}
.note .question .options .option .content{
  padding-left: 5px;
}
.note .btn-area{
  margin-top: 10px;
  display: flex;
  flex-direction: row;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.note .btn-area .button{
  color: #fff;
  text-align: center;
  background-color: #07c160;
  border-radius: 20px;
  width:375rpx;
  padding: 5px 15px;
}
.note .btn-area .gray{
  background-color: #cccfd4;
  color: #fff;
  text-align: center;
  border-radius: 20px;
  width:250px;
  padding: 10px 15px;
}
.note .footer{
  padding: 10px;
}
.note .footer .btn-area{
  display: flex;
  flex-direction: row;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 10px 0;
}
.note .footer .btn-area .button{
  color: #fff;
  text-align: center;
  background-color: #7b99fe;
  border-radius: 20px;
  width:250px;
  padding: 10px 15px;
}
.wrong{
  background-color: #f9e5e0;
}