/* pages/activate/index.wxss */
page {
  background: #f5f5f7;
  min-height: 100vh;
}

.activate-page {
  padding: 0 32rpx 60rpx;
}

/* 顶部欢迎区 */
.header {
  padding: 80rpx 0 60rpx;
  text-align: center;
}

.logo {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}

.title {
  font-size: 44rpx;
  color: #333;
  font-weight: 600;
}

.subtitle {
  font-size: 26rpx;
  color: #888;
  margin-top: 12rpx;
}

/* 停用/异常提示 */
.reason-box {
  background: #fff4e0;
  color: #c97e00;
  font-size: 26rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

/* 表单 */
.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.form-input {
  font-size: 30rpx;
  color: #333;
  width: 100%;
  height: 60rpx;
  line-height: 60rpx;
}

.picker-display {
  font-size: 30rpx;
  color: #333;
  height: 60rpx;
  line-height: 60rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-display.placeholder {
  color: #c0c0c0;
}

.picker-arrow {
  color: #ccc;
  font-size: 36rpx;
}

/* 提示文字 */
.tips {
  padding: 24rpx 8rpx 0;
}

.tip-item {
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 60rpx;
  background: linear-gradient(135deg, #1bcfad 0%, #14b39a 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(27, 207, 173, 0.3);
}

.submit-btn::after {
  border: none;
}

.submit-btn.submitting {
  opacity: 0.6;
  box-shadow: none;
}

.submit-btn:active {
  opacity: 0.85;
}
