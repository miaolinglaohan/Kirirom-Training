/* pages/home/index.wxss */
page {
  background: #f5f5f7;
  min-height: 100vh;
}

.home-page {
  padding-bottom: 40rpx;
}

/* —— 顶部统计条 —— */
.stats-bar {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 36rpx 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-label {
  font-size: 26rpx;
  color: #888;
}

.stat-value {
  font-size: 48rpx;
  color: #1bcfad;
  font-weight: 600;
  margin: 8rpx 0;
}

.stat-sub {
  font-size: 22rpx;
  color: #aaa;
}

.stat-divider {
  width: 2rpx;
  height: 80rpx;
  background: #ececec;
}

/* —— 考试通知卡片 —— */
.exam-card {
  margin: 24rpx 24rpx 0;
  background: linear-gradient(135deg, #1bcfad 0%, #14b39a 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(27, 207, 173, 0.25);
}

.exam-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.exam-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.exam-title {
  font-size: 32rpx;
  font-weight: 600;
}

.exam-card-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.exam-time {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.exam-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  background: rgba(255, 255, 255, 0.25);
}

.status-pending { background: rgba(255, 255, 255, 0.25); }
.status-ongoing { background: #fff; color: #1bcfad; font-weight: 600; }
.status-submitted { background: rgba(255, 255, 255, 0.15); }
.status-expired { background: rgba(0, 0, 0, 0.2); }

.exam-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.exam-action {
  font-size: 28rpx;
}

.exam-arrow {
  font-size: 40rpx;
}

/* 无考试占位 */
.empty-exam-card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.empty-text {
  font-size: 26rpx;
  color: #aaa;
}

.empty-action {
  font-size: 26rpx;
  color: #1bcfad;
}

/* —— 两个大圆形按钮 —— */
.big-buttons {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 50rpx 24rpx 30rpx;
}

.big-btn {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.big-btn-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.big-btn-blue {
  background: linear-gradient(135deg, #4a90e2 0%, #2e6fcc 100%);
  box-shadow: 0 12rpx 30rpx rgba(74, 144, 226, 0.4);
}

.big-btn-green {
  background: linear-gradient(135deg, #2bd47d 0%, #1bcfad 100%);
  box-shadow: 0 12rpx 30rpx rgba(43, 212, 125, 0.4);
}

.big-btn:active {
  transform: scale(0.96);
  opacity: 0.92;
}

.big-btn-icon {
  font-size: 54rpx;
  margin-bottom: 8rpx;
}

.big-btn-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.big-btn-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

/* —— 入口图标网格 —— */
.entry-grid {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 30rpx 0;
  display: flex;
  flex-wrap: wrap;
}

.entry-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.entry-item:active {
  opacity: 0.7;
}

.entry-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.icon-1 { background: #e0f7f1; }
.icon-2 { background: #fff4e0; }
.icon-3 { background: #ffe6e6; }
.icon-4 { background: #e6efff; }
.icon-5 { background: #f0e6ff; }
.icon-6 { background: #e6f7ff; }

.entry-label {
  font-size: 26rpx;
  color: #333;
}

/* —— 题库分类 —— */
.section-title-bar {
  margin: 32rpx 24rpx 16rpx;
  display: flex;
  align-items: center;
}

.section-title-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.exam-list {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.exam-list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.exam-list-item:last-child {
  border-bottom: 0;
}

.exam-list-item:active {
  background: #f8f8f8;
}

.exam-list-num {
  width: 44rpx;
  height: 44rpx;
  background: #1bcfad;
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 44rpx;
  font-size: 24rpx;
}

.exam-list-name {
  flex: 1;
  padding-left: 20rpx;
  font-size: 30rpx;
  color: #333;
}

.exam-list-arrow {
  font-size: 36rpx;
  color: #ccc;
}
