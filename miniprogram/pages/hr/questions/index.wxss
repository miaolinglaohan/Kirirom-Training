.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  background: #f5f6fa;
  box-sizing: border-box;
}
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 12rpx 16rpx;
}
.title-wrap { flex: 1; min-width: 0; }
.title { font-size: 36rpx; font-weight: 600; color: #1a1a1a; }
.sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #888;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.add-btn { margin: 0; font-size: 24rpx; flex-shrink: 0; }

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 6rpx;
  margin: 8rpx 0 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  color: #666;
  border-radius: 10rpx;
}
.tab.active {
  background: #2d8cf0;
  color: #fff;
  font-weight: 600;
}

.count {
  padding: 0 12rpx 12rpx;
  font-size: 22rpx;
  color: #999;
}

.loading, .empty {
  text-align: center;
  padding: 60rpx 24rpx;
  color: #999;
  font-size: 28rpx;
  line-height: 1.7;
}

.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.type-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #eef0f4;
  color: #555;
}
.type-tag.single { background: #e0f7f1; color: #1baa7a; }
.type-tag.multi  { background: #fff4e0; color: #d68b00; }
.type-tag.judge  { background: #f0e6ff; color: #7b3ff5; }

.opt-count {
  font-size: 22rpx;
  color: #999;
}

.q-title {
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.55;
  word-break: break-all;
}

.correct {
  margin-top: 10rpx;
  font-size: 24rpx;
}
.correct .lbl { color: #888; }
.correct .val { color: #1baa7a; font-weight: 600; }

.actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}
.btn {
  margin: 0;
  font-size: 24rpx;
  background: #eef0f4;
  color: #333;
}
.btn.warn { background: #f56c6c; color: #fff; }

.more {
  text-align: center;
  padding: 24rpx;
  font-size: 22rpx;
  color: #bbb;
}
.more.end { color: #ccc; }
