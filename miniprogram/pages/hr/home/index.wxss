.page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  background: #f5f6fa;
  box-sizing: border-box;
}

.header { padding: 16rpx 12rpx 28rpx; }
.title { font-size: 44rpx; font-weight: 600; color: #1a1a1a; }
.subtitle { margin-top: 8rpx; font-size: 26rpx; color: #888; }

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  position: relative;
  width: 48%;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card.disabled { opacity: 0.62; }

.icon { font-size: 60rpx; line-height: 1; margin-bottom: 16rpx; }
.card-title { font-size: 32rpx; font-weight: 600; color: #1a1a1a; }
.card-desc { margin-top: 8rpx; font-size: 24rpx; color: #888; }

.badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  color: #fff;
  background: #b0b0b0;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.footer-tip {
  margin-top: 16rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

/* 临时：M2 PDF 测试入口，M3 完成后随入口一起移除 */
.test-area {
  margin: 16rpx 0 12rpx;
  padding: 20rpx;
  background: #fffbe6;
  border: 2rpx dashed #f0c050;
  border-radius: 12rpx;
}
.test-btn {
  background: #f0c050;
  color: #5a3d00;
  font-size: 26rpx;
  border-radius: 12rpx;
  margin: 0;
}
.test-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a07a00;
  line-height: 1.5;
}

/* 隐藏 canvas：必须有非零尺寸才能拿到 node，但位置移出屏幕 */
.pdf-canvas-hidden {
  position: fixed;
  left: -10000rpx;
  top: -10000rpx;
  width: 100rpx;
  height: 100rpx;
  pointer-events: none;
}
