<view class="page">
  <view class="header">
    <view class="title">管理后台</view>
    <view class="subtitle" wx:if="{{me}}">{{me.name}} · {{me.dept || '未分配部门'}}</view>
  </view>

  <view class="grid">
    <view class="card" bindtap="goEmployees">
      <view class="icon">🛠</view>
      <view class="card-title">员工管理</view>
      <view class="card-desc">查看 / 切换角色 / 启停</view>
    </view>

    <view class="card" bindtap="goAssessments">
      <view class="icon">📋</view>
      <view class="card-title">考试管理</view>
      <view class="card-desc">新建 / 编辑 / 查看报名</view>
    </view>

    <view class="card" bindtap="goSubjects">
      <view class="icon">📚</view>
      <view class="card-title">题库管理</view>
      <view class="card-desc">新建 / 编辑题库，进入题目</view>
    </view>

    <view class="card" bindtap="goQuestions">
      <view class="icon">❓</view>
      <view class="card-title">题目管理</view>
      <view class="card-desc">通过题库进入题目维护</view>
    </view>

    <view class="card" wx:if="{{me.role === 'admin'}}" bindtap="goSettings">
      <view class="icon">⚙️</view>
      <view class="card-title">系统设置</view>
      <view class="card-desc">PDF 水印等全局配置（仅 admin）</view>
    </view>
  </view>

  <!-- 临时：M2 PDF 容器自测入口，M3 完成后会移除 -->
  <view class="test-area" wx:if="{{me.role === 'admin'}}">
    <button class="test-btn" bindtap="onTestPdf" loading="{{testing}}" disabled="{{testing}}">
      🧪 测试 PDF 导出（M2 验收用，将移除）
    </button>
    <view class="test-tip">点击后会生成一张 2 页 demo PDF：白底 + 文字 + 半透明斜向水印，自动打开预览。</view>
  </view>

  <view class="footer-tip">提示：题目管理需先进入对应题库，再点「查看题目」。</view>

  <!-- 隐藏 canvas：PDF 导出的实际绘图容器（不可移除其 type/id） -->
  <canvas type="2d" id="pdfTestCanvas" class="pdf-canvas-hidden"></canvas>
</view>
