.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  background: #f5f6fa;
  box-sizing: border-box;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 26rpx;
  color: #888;
  padding: 20rpx 0 8rpx;
}

.row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef0f4;
}
.row:last-child { border-bottom: none; }

.label {
  width: 180rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.picker { flex: 1; }
.picker-text {
  font-size: 28rpx;
  color: #1a1a1a;
  padding: 4rpx 0;
}
.picker-text.placeholder { color: #b0b0b0; }

.tz-hint {
  font-size: 24rpx;
  color: #07c160;
  background: #e8f8ee;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.qrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef0f4;
}
.qrow:last-child { border-bottom: none; }
.qlabel { width: 100rpx; font-size: 28rpx; color: #333; }
.qinput {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f5f6fa;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}
.qinput .hint { font-size: 22rpx; color: #999; }
.qinput .num { flex: 1; text-align: right; font-size: 28rpx; }

.footer { padding: 24rpx 0; }
.submit { font-size: 30rpx; }
