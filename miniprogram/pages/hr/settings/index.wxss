.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  background: #f5f6fa;
  box-sizing: border-box;
}

.loading {
  text-align: center;
  padding: 60rpx 24rpx;
  color: #999;
  font-size: 28rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}
.section-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;          /* 固定 ~1.5 行，避免 textarea 默认高度过大 */
  padding: 16rpx 18rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  background: #fafbfc;
  line-height: 1.5;
}

.counter {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: #b0b0b0;
}

.actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
.btn-ghost {
  margin: 0;
  font-size: 26rpx;
  background: #eef0f4;
  color: #333;
}
.btn-primary {
  margin: 0;
  font-size: 26rpx;
  background: #1bcfad;
  color: #fff;
}

.tip {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #a07a00;
  background: #fffbe6;
  border-left: 6rpx solid #f0c050;
  border-radius: 8rpx;
  line-height: 1.6;
}
