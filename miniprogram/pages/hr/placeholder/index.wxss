.page {
  min-height: 100vh;
  background: #f5f6fa;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  width: 100%;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.emoji { font-size: 100rpx; line-height: 1; }
.title { margin-top: 16rpx; font-size: 36rpx; font-weight: 600; color: #1a1a1a; }
.tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  white-space: pre-line;
}
.back { margin-top: 32rpx; }
