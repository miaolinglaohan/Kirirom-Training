.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  background: #f5f6fa;
  box-sizing: border-box;
}
.header { padding: 12rpx 12rpx 20rpx; }
.title { font-size: 40rpx; font-weight: 600; color: #1a1a1a; }
.subtitle { margin-top: 6rpx; font-size: 24rpx; color: #888; }

.loading, .empty { text-align: center; padding: 60rpx 0; color: #999; font-size: 28rpx; }

.list { display: flex; flex-direction: column; gap: 20rpx; }

.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.row1 { display: flex; align-items: center; gap: 12rpx; }
.name { font-size: 30rpx; font-weight: 600; color: #1a1a1a; }
.tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  color: #fff;
}
.tag.hr { background: #2d8cf0; }
.tag.admin { background: #f5a623; }
.tag.off { background: #b0b0b0; }

.row2 { margin-top: 8rpx; font-size: 24rpx; color: #888; }
.row2 .self { color: #2d8cf0; margin-left: 4rpx; }

.actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}
.btn {
  margin: 0;
  font-size: 24rpx;
  background: #eef0f4;
  color: #333;
}
.btn.primary { background: #2d8cf0; color: #fff; }
.btn.warn { background: #f56c6c; color: #fff; }
