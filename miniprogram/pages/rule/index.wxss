/* pages/rule/index.wxss */
page {
  background: #f5f6fa;
  min-height: 100vh;
}

.page-guide {
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #07c160 0%, #06a04f 100%);
  padding: 48rpx 32rpx 40rpx;
}
.header .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}
.header .subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 14rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}
.sec-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.sec-body text {
  font-size: 27rpx;
  color: #555;
  line-height: 1.7;
}

.footer {
  text-align: center;
  padding: 40rpx 32rpx;
  color: #aaa;
  font-size: 24rpx;
}
